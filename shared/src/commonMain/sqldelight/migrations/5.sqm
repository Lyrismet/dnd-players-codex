-- what a person deleted stays remembered here so an import does not bring it back, it never goes into a file
CREATE TABLE deleted_origin (
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE,
    kind TEXT NOT NULL,
    origin_id TEXT NOT NULL,
    name TEXT NOT NULL,
    PRIMARY KEY (campaign_id, kind, origin_id)
);

CREATE TABLE kept_apart (
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE,
    kind TEXT NOT NULL,
    file_origin_id TEXT NOT NULL,
    local_origin_id TEXT NOT NULL,
    PRIMARY KEY (campaign_id, kind, file_origin_id, local_origin_id)
);

CREATE TABLE import_journal (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE,
    action TEXT NOT NULL,
    kind TEXT NOT NULL,
    row_id INTEGER NOT NULL DEFAULT 0,
    ref TEXT NOT NULL DEFAULT '',
    snapshot TEXT NOT NULL DEFAULT '',
    flag INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX import_journal_campaign_id ON import_journal(campaign_id);

CREATE TRIGGER species_remember_deleted AFTER DELETE ON species
WHEN EXISTS (SELECT 1 FROM campaign WHERE id = old.campaign_id) AND old.origin_id != ''
BEGIN
    INSERT OR REPLACE INTO deleted_origin(campaign_id, kind, origin_id, name) VALUES (old.campaign_id, 'SPECIES', old.origin_id, old.name);
END;

CREATE TRIGGER species_forget_deleted AFTER INSERT ON species
BEGIN
    DELETE FROM deleted_origin WHERE campaign_id = new.campaign_id AND kind = 'SPECIES' AND origin_id = new.origin_id;
END;

