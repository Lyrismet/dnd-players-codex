CREATE TABLE session_note_npc (
    session_note_id INTEGER NOT NULL REFERENCES session_note(id) ON DELETE CASCADE,
    npc_id INTEGER NOT NULL REFERENCES npc(id) ON DELETE CASCADE,
    PRIMARY KEY (session_note_id, npc_id)
);

CREATE TABLE session_note_quest (
    session_note_id INTEGER NOT NULL REFERENCES session_note(id) ON DELETE CASCADE,
    quest_id INTEGER NOT NULL REFERENCES quest(id) ON DELETE CASCADE,
    PRIMARY KEY (session_note_id, quest_id)
);

CREATE TABLE session_note_location (
    session_note_id INTEGER NOT NULL REFERENCES session_note(id) ON DELETE CASCADE,
    location_id INTEGER NOT NULL REFERENCES location(id) ON DELETE CASCADE,
    PRIMARY KEY (session_note_id, location_id)
);

insertNpcMention:
INSERT OR IGNORE INTO session_note_npc(session_note_id, npc_id) VALUES (?, ?);

insertQuestMention:
INSERT OR IGNORE INTO session_note_quest(session_note_id, quest_id) VALUES (?, ?);

insertLocationMention:
INSERT OR IGNORE INTO session_note_location(session_note_id, location_id) VALUES (?, ?);

deleteNpcMentions:
DELETE FROM session_note_npc WHERE session_note_id = ?;

deleteQuestMentions:
DELETE FROM session_note_quest WHERE session_note_id = ?;

deleteLocationMentions:
DELETE FROM session_note_location WHERE session_note_id = ?;

selectMentionedNpcIds:
SELECT npc_id FROM session_note_npc WHERE session_note_id = ?;

selectMentionedQuestIds:
SELECT quest_id FROM session_note_quest WHERE session_note_id = ?;

selectMentionedLocationIds:
SELECT location_id FROM session_note_location WHERE session_note_id = ?;

selectSessionNotesMentioningNpc:
SELECT session_note_id FROM session_note_npc WHERE npc_id = ?;

selectSessionNotesMentioningQuest:
SELECT session_note_id FROM session_note_quest WHERE quest_id = ?;

selectSessionNotesMentioningLocation:
SELECT session_note_id FROM session_note_location WHERE location_id = ?;
