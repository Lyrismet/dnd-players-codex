CREATE TABLE location (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    parent_id INTEGER REFERENCES location(id) ON DELETE SET NULL
);

CREATE INDEX location_parent_id ON location(parent_id);

selectAll:
SELECT * FROM location ORDER BY name;

selectById:
SELECT * FROM location WHERE id = ?;

insert:
INSERT INTO location(name, description, parent_id)
VALUES (?, ?, ?);

update:
UPDATE location
SET name = ?, description = ?, parent_id = ?
WHERE id = ?;

deleteById:
DELETE FROM location WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
