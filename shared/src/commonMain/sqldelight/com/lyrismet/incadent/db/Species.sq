import com.lyrismet.incadent.feature.codex.domain.model.CreatureType;

CREATE TABLE species (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    creature_type TEXT AS CreatureType NOT NULL,
    vulnerabilities TEXT NOT NULL DEFAULT '',
    notes TEXT NOT NULL DEFAULT '',
    hit_points INTEGER,
    photo BLOB,
    photo_thumb BLOB,
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE,
    origin_id TEXT NOT NULL DEFAULT '',
    custom_type_id INTEGER REFERENCES creature_type(id) ON DELETE SET NULL
);

CREATE INDEX species_campaign_id ON species(campaign_id);
CREATE UNIQUE INDEX species_origin_id ON species(campaign_id, origin_id);
CREATE INDEX species_custom_type_id ON species(custom_type_id);

-- list queries leave the full jpeg out, a row carries only its thumbnail
selectAll:
SELECT s.id, s.name, s.creature_type, s.vulnerabilities, s.notes, s.hit_points, s.photo_thumb, s.origin_id, s.custom_type_id, t.name AS custom_type_name
FROM species s LEFT JOIN creature_type t ON t.id = s.custom_type_id
WHERE s.campaign_id = ? ORDER BY s.name;

selectById:
SELECT s.id, s.name, s.creature_type, s.vulnerabilities, s.notes, s.hit_points, s.photo_thumb, s.photo, s.origin_id, s.custom_type_id, t.name AS custom_type_name
FROM species s LEFT JOIN creature_type t ON t.id = s.custom_type_id
WHERE s.id = ?;

insert:
INSERT INTO species(name, creature_type, vulnerabilities, notes, hit_points, photo, photo_thumb, campaign_id, origin_id, custom_type_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- puts a deleted record back under its old id, so the "@" tokens in notes find it again
insertWithId:
INSERT INTO species(id, name, creature_type, vulnerabilities, notes, hit_points, photo, photo_thumb, campaign_id, origin_id, custom_type_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- the photo is written on its own, so saving a list-level model never touches it
update:
UPDATE species
SET name = ?, creature_type = ?, custom_type_id = ?, vulnerabilities = ?, notes = ?, hit_points = ?
WHERE id = ?;

-- an import leaves the hit points alone when the file does not know them, an older file never does
updateImported:
UPDATE species
SET name = ?, creature_type = ?, custom_type_id = ?, vulnerabilities = ?, notes = ?, hit_points = COALESCE(?, hit_points)
WHERE id = ?;

setPhoto:
UPDATE species SET photo = ?, photo_thumb = ? WHERE id = ?;

deleteById:
DELETE FROM species WHERE id = ?;

-- the stored jpeg sizes, what an export estimates its file from
selectPhotoSizes:
SELECT id, COALESCE(length(photo), 0) AS size FROM species WHERE campaign_id = ?;

-- one stored jpeg, so an export reads a photo at a time without the other columns
selectPhoto:
SELECT photo FROM species WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
