import com.lyrismet.incadent.feature.codex.domain.model.NpcLifeState;
import com.lyrismet.incadent.feature.codex.domain.model.NpcStatus;
CREATE TABLE npc (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    status TEXT AS NpcStatus NOT NULL,
    description TEXT NOT NULL,
    race TEXT NOT NULL DEFAULT '',
    life_state TEXT AS NpcLifeState NOT NULL DEFAULT 'ALIVE',
    nicknames TEXT NOT NULL DEFAULT '',
    species_id INTEGER REFERENCES species(id) ON DELETE SET NULL,
    vulnerabilities TEXT NOT NULL DEFAULT '',
    portrait BLOB,
    portrait_thumb BLOB,
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE
);

CREATE INDEX npc_campaign_id ON npc(campaign_id);
CREATE INDEX npc_species_id ON npc(species_id);

-- list queries leave the full jpeg out, a row carries only its thumbnail
selectAll:
SELECT id, name, status, description, race, life_state, nicknames, species_id, vulnerabilities, portrait_thumb
FROM npc
WHERE campaign_id = ?
ORDER BY name;

-- places come along in the same query so a write to either table re-emits one consistent list
selectAllWithLocations:
SELECT
    npc.id, npc.name, npc.status, npc.description, npc.race, npc.life_state, npc.nicknames,
    npc.species_id, npc.vulnerabilities, npc.portrait_thumb,
    COALESCE((SELECT group_concat(location_id) FROM npc_location WHERE npc_id = npc.id), '') AS location_ids
FROM npc
WHERE campaign_id = ?
ORDER BY name;

selectById:
SELECT id, name, status, description, race, life_state, nicknames, species_id, vulnerabilities, portrait_thumb, portrait
FROM npc
WHERE id = ?;

insert:
INSERT INTO npc(name, status, description, race, life_state, nicknames, species_id, vulnerabilities, portrait, portrait_thumb, campaign_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- puts a deleted record back under its old id, so the "@" tokens in notes find it again
insertWithId:
INSERT INTO npc(id, name, status, description, race, life_state, nicknames, species_id, vulnerabilities, portrait, portrait_thumb, campaign_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- the photo is written on its own, so saving a list-level model never touches it
update:
UPDATE npc
SET name = ?, status = ?, description = ?, race = ?, life_state = ?, nicknames = ?, species_id = ?, vulnerabilities = ?
WHERE id = ?;

setPortrait:
UPDATE npc SET portrait = ?, portrait_thumb = ? WHERE id = ?;


deleteById:
DELETE FROM npc WHERE id = ?;

-- the stored jpeg sizes, what an export estimates its file from
selectPhotoSizes:
SELECT id, COALESCE(length(portrait), 0) AS size FROM npc WHERE campaign_id = ?;

-- one stored jpeg, so an export reads a photo at a time without the other columns
selectPhoto:
SELECT portrait FROM npc WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
