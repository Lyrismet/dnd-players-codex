import com.lyrismet.incadent.domain.model.NpcLifeState;
import com.lyrismet.incadent.domain.model.NpcStatus;

CREATE TABLE npc (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    status TEXT AS NpcStatus NOT NULL,
    description TEXT NOT NULL,
    location_id INTEGER REFERENCES location(id) ON DELETE SET NULL,
    race TEXT NOT NULL DEFAULT '',
    faction TEXT NOT NULL DEFAULT '',
    life_state TEXT AS NpcLifeState NOT NULL DEFAULT 'ALIVE',
    portrait_base64 TEXT
);

CREATE INDEX npc_location_id ON npc(location_id);

selectAll:
SELECT * FROM npc ORDER BY name;

selectById:
SELECT * FROM npc WHERE id = ?;

selectByLocation:
SELECT * FROM npc WHERE location_id = ?;

insert:
INSERT INTO npc(name, status, description, location_id, race, faction, life_state, portrait_base64)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE npc
SET name = ?, status = ?, description = ?, location_id = ?, race = ?, faction = ?, life_state = ?,
    portrait_base64 = ?
WHERE id = ?;

deleteById:
DELETE FROM npc WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
