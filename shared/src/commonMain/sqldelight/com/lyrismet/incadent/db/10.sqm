-- 9.sqm left parent_id pointing at the temporary location_new, so every write to location failed - rebuilt here,
-- links are stashed first because dropping location would cascade npc_location and null quest.location_id
CREATE TABLE npc_location_stash (
    npc_id INTEGER NOT NULL,
    location_id INTEGER NOT NULL
);

INSERT INTO npc_location_stash(npc_id, location_id)
SELECT npc_id, location_id FROM npc_location;

CREATE TABLE quest_location_stash (
    quest_id INTEGER NOT NULL,
    location_id INTEGER NOT NULL
);

INSERT INTO quest_location_stash(quest_id, location_id)
SELECT id, location_id FROM quest WHERE location_id IS NOT NULL;

CREATE TABLE location_fixed (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    parent_id INTEGER REFERENCES location(id) ON DELETE SET NULL
);

INSERT INTO location_fixed(id, name, description, parent_id)
SELECT id, name, description, parent_id FROM location;

DROP TABLE location;
ALTER TABLE location_fixed RENAME TO location;

CREATE INDEX location_parent_id ON location(parent_id);

INSERT OR IGNORE INTO npc_location(npc_id, location_id)
SELECT npc_id, location_id FROM npc_location_stash;

UPDATE quest
SET location_id = (SELECT s.location_id FROM quest_location_stash s WHERE s.quest_id = quest.id)
WHERE id IN (SELECT quest_id FROM quest_location_stash);

DROP TABLE npc_location_stash;
DROP TABLE quest_location_stash;
