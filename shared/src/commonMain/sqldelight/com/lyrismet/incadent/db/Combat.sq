import com.lyrismet.incadent.feature.combat.domain.model.CombatOutcome;
import com.lyrismet.incadent.feature.combat.domain.model.CombatPhase;
import kotlinx.datetime.LocalDateTime;

CREATE TABLE combat (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    session_note_id INTEGER REFERENCES session_note(id) ON DELETE SET NULL,
    phase TEXT AS CombatPhase NOT NULL,
    started_at TEXT AS LocalDateTime NOT NULL,
    round INTEGER NOT NULL DEFAULT 1,
    outcome TEXT AS CombatOutcome,
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE
);

selectAll:
SELECT * FROM combat
WHERE campaign_id = ?
ORDER BY id DESC;

selectById:
SELECT * FROM combat WHERE id = ? AND campaign_id = ?;

insert:
INSERT INTO combat(session_note_id, phase, started_at, round, campaign_id) VALUES (?, 'PREPARING', ?, 1, ?);

updateRound:
UPDATE combat SET round = ? WHERE id = ?;

updateOutcome:
UPDATE combat SET outcome = ?, phase = 'FINISHED' WHERE id = ?;

deleteById:
DELETE FROM combat WHERE id = ? AND campaign_id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
