CREATE TABLE combat_scratchpad (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    session_note_id INTEGER REFERENCES session_note(id) ON DELETE SET NULL,
    boss_name TEXT NOT NULL,
    boss_hp_current INTEGER NOT NULL,
    boss_hp_max INTEGER NOT NULL,
    notes TEXT NOT NULL
);

CREATE TABLE combatant (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    combat_scratchpad_id INTEGER NOT NULL REFERENCES combat_scratchpad(id) ON DELETE CASCADE,
    npc_id INTEGER REFERENCES npc(id) ON DELETE SET NULL,
    name TEXT NOT NULL,
    initiative INTEGER NOT NULL,
    hp_current INTEGER NOT NULL,
    hp_max INTEGER NOT NULL,
    is_player_character INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX combatant_scratchpad_id ON combatant(combat_scratchpad_id);
