import kotlin.Boolean;
import kotlinx.datetime.LocalDateTime;
CREATE TABLE session_entry (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    session_note_id INTEGER NOT NULL REFERENCES session_note(id) ON DELETE CASCADE,
    created_at TEXT AS LocalDateTime NOT NULL,
    body TEXT NOT NULL,
    edited INTEGER AS Boolean NOT NULL DEFAULT 0,
    mention_check INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE INDEX session_entry_session_note_id ON session_entry(session_note_id);

selectForSession:
SELECT * FROM session_entry WHERE session_note_id = ? ORDER BY created_at ASC;

selectAll:
SELECT session_entry.id, session_entry.session_note_id, session_entry.created_at, session_entry.body,
    session_entry.edited, session_entry.mention_check
FROM session_entry
INNER JOIN session_note ON session_note.id = session_entry.session_note_id
WHERE session_note.campaign_id = ?
ORDER BY session_entry.created_at ASC;

insert:
INSERT INTO session_entry(session_note_id, created_at, body, edited, mention_check)
VALUES (?, ?, ?, ?, ?);

insertWithId:
INSERT INTO session_entry(id, session_note_id, created_at, body, edited, mention_check)
VALUES (?, ?, ?, ?, ?, ?);

updateBody:
UPDATE session_entry SET body = ?, edited = 1, mention_check = 1 WHERE id = ?;

renameBody:
UPDATE session_entry SET body = ? WHERE id = ?;

setMentionCheck:
UPDATE session_entry SET mention_check = ? WHERE id = ?;

deleteById:
DELETE FROM session_entry WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
