import com.lyrismet.incadent.feature.combat.domain.model.CombatSide;
import com.lyrismet.incadent.feature.combat.domain.model.CombatState;

CREATE TABLE combatant (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    combat_id INTEGER NOT NULL REFERENCES combat(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    side TEXT AS CombatSide NOT NULL,
    npc_id INTEGER REFERENCES npc(id) ON DELETE SET NULL,
    species_id INTEGER REFERENCES species(id) ON DELETE SET NULL,
    party_member_id INTEGER REFERENCES party_member(id) ON DELETE SET NULL,
    entered_whole INTEGER NOT NULL DEFAULT 1,
    state TEXT AS CombatState NOT NULL,
    joined_round INTEGER NOT NULL DEFAULT 1,
    death_successes INTEGER NOT NULL DEFAULT 0,
    death_failures INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX combatant_combat_id ON combatant(combat_id);

selectByCombat:
SELECT * FROM combatant WHERE combat_id = ? ORDER BY id;

selectByCampaign:
SELECT combatant.* FROM combatant
JOIN combat ON combat.id = combatant.combat_id
WHERE combat.campaign_id = ?
ORDER BY combatant.id;

insert:
INSERT INTO combatant(combat_id, name, side, npc_id, species_id, party_member_id, entered_whole, state, joined_round, death_successes, death_failures)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateState:
UPDATE combatant SET state = ? WHERE id = ?;

updateDeathSaves:
UPDATE combatant SET death_successes = ?, death_failures = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
