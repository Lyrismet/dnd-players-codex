import com.lyrismet.incadent.feature.combat.domain.model.CombatCondition;
import com.lyrismet.incadent.feature.combat.domain.model.CombatSide;
import com.lyrismet.incadent.feature.combat.domain.model.CombatStance;
import com.lyrismet.incadent.feature.combat.domain.model.CombatState;
import kotlin.collections.Set;

CREATE TABLE combatant (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    combat_id INTEGER NOT NULL REFERENCES combat(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    side TEXT AS CombatSide NOT NULL,
    npc_id INTEGER REFERENCES npc(id) ON DELETE SET NULL,
    species_id INTEGER REFERENCES species(id) ON DELETE SET NULL,
    party_member_id INTEGER REFERENCES party_member(id) ON DELETE SET NULL,
    entered_whole INTEGER NOT NULL DEFAULT 1,
    state TEXT AS CombatState NOT NULL,
    joined_round INTEGER NOT NULL DEFAULT 1,
    death_successes INTEGER NOT NULL DEFAULT 0,
    death_failures INTEGER NOT NULL DEFAULT 0,
    temp_hp INTEGER NOT NULL DEFAULT 0,
    turn_order INTEGER,
    stance TEXT AS CombatStance NOT NULL,
    captured INTEGER NOT NULL DEFAULT 0,
    dead INTEGER NOT NULL DEFAULT 0,
    conditions TEXT AS Set<CombatCondition> NOT NULL,
    note TEXT NOT NULL DEFAULT '',
    reaction_available INTEGER NOT NULL DEFAULT 1,
    hp_current INTEGER,
    hp_max INTEGER,
    role TEXT NOT NULL DEFAULT '',
    is_label INTEGER NOT NULL DEFAULT 0,
    vulnerabilities TEXT NOT NULL DEFAULT '',
    facts TEXT NOT NULL DEFAULT ''
);

CREATE INDEX combatant_combat_id ON combatant(combat_id);
CREATE INDEX combatant_npc_id ON combatant(npc_id);
CREATE INDEX combatant_species_id ON combatant(species_id);
CREATE INDEX combatant_party_member_id ON combatant(party_member_id);

-- a record deleted from the codex leaves the preparations that picked it, a fight under way keeps its fighters
CREATE TRIGGER combatant_npc_deleted BEFORE DELETE ON npc
BEGIN
    DELETE FROM combatant WHERE npc_id = old.id AND combat_id IN (SELECT id FROM combat WHERE phase = 'PREPARING');
END;

CREATE TRIGGER combatant_species_deleted BEFORE DELETE ON species
BEGIN
    DELETE FROM combatant WHERE species_id = old.id AND combat_id IN (SELECT id FROM combat WHERE phase = 'PREPARING');
END;

CREATE TRIGGER combatant_party_deleted BEFORE DELETE ON party_member
BEGIN
    DELETE FROM combatant WHERE party_member_id = old.id AND combat_id IN (SELECT id FROM combat WHERE phase = 'PREPARING');
END;

selectByCombat:
SELECT * FROM combatant WHERE combat_id = ? ORDER BY id;

-- the name a linked participant answers to is the codex one, so a rename there shows in the fight at once
selectCodexNames:
SELECT combatant.id, COALESCE(npc.name, party_member.name) AS codex_name FROM combatant
LEFT JOIN npc ON npc.id = combatant.npc_id
LEFT JOIN party_member ON party_member.id = combatant.party_member_id
WHERE combatant.combat_id = ?;

selectCodexNamesByCampaign:
SELECT combatant.id, COALESCE(npc.name, party_member.name) AS codex_name FROM combatant
JOIN combat ON combat.id = combatant.combat_id
LEFT JOIN npc ON npc.id = combatant.npc_id
LEFT JOIN party_member ON party_member.id = combatant.party_member_id
WHERE combat.campaign_id = ?;

selectByCampaign:
SELECT combatant.* FROM combatant
JOIN combat ON combat.id = combatant.combat_id
WHERE combat.campaign_id = ?
ORDER BY combatant.id;

insert:
INSERT INTO combatant(combat_id, name, side, npc_id, species_id, party_member_id, entered_whole, state, joined_round, death_successes, death_failures, temp_hp, turn_order, stance, captured, dead, conditions, note, reaction_available, hp_current, hp_max, role, is_label)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateMember:
UPDATE combatant
SET name = ?, entered_whole = ?, state = ?, death_successes = ?, death_failures = ?, temp_hp = ?, turn_order = ?, stance = ?, captured = ?, dead = ?, conditions = ?, note = ?, reaction_available = ?, hp_current = ?, hp_max = ?, role = ?, is_label = ?
WHERE id = ?;

updateTurnOrder:
UPDATE combatant SET turn_order = ? WHERE id = ?;

clearTurnOrders:
UPDATE combatant SET turn_order = NULL WHERE combat_id = ?;

updateTempHp:
UPDATE combatant SET temp_hp = ? WHERE id = ?;

updateNpc:
UPDATE combatant SET npc_id = ?, name = ? WHERE id = ?;

updateVulnerabilities:
UPDATE combatant SET vulnerabilities = ? WHERE id = ?;

updateFacts:
UPDATE combatant SET facts = ? WHERE id = ?;

updateRole:
UPDATE combatant SET role = ? WHERE id = ?;

syncNpcName:
UPDATE combatant SET name = ? WHERE npc_id = ?;

keepNameOfNpc:
UPDATE combatant SET is_label = 1 WHERE npc_id = ?;

updateName:
UPDATE combatant SET name = ? WHERE id = ?;

updateLabel:
UPDATE combatant SET name = ?, is_label = ? WHERE id = ?;

deleteById:
DELETE FROM combatant WHERE id = ?;



lastInsertRowId:
SELECT last_insert_rowid();
