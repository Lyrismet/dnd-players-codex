CREATE TABLE phrase_snippet (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    text TEXT NOT NULL,
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE,
    UNIQUE (campaign_id, text)
);

selectAll:
SELECT id, text FROM phrase_snippet WHERE campaign_id = ? ORDER BY id ASC;

insert:
INSERT OR IGNORE INTO phrase_snippet(text, campaign_id) VALUES (?, ?);

deleteByText:
DELETE FROM phrase_snippet WHERE text = ? AND campaign_id = ?;
