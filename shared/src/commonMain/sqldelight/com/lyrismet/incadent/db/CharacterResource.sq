CREATE TABLE character_resource (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    party_member_id INTEGER NOT NULL REFERENCES party_member(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    max_value INTEGER NOT NULL DEFAULT 1,
    current_value INTEGER NOT NULL DEFAULT 0,
    slot_level INTEGER,
    position INTEGER NOT NULL DEFAULT 0,
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE,
    origin_id TEXT NOT NULL DEFAULT ''
);

CREATE INDEX character_resource_party_member_id ON character_resource(party_member_id);
CREATE INDEX character_resource_campaign_id ON character_resource(campaign_id);
CREATE UNIQUE INDEX character_resource_origin_id ON character_resource(campaign_id, origin_id);

selectByMember:
SELECT id, party_member_id, name, max_value, current_value, slot_level, position, origin_id
FROM character_resource WHERE party_member_id = ?
ORDER BY slot_level IS NOT NULL, slot_level, position, id;

selectById:
SELECT id, party_member_id, name, max_value, current_value, slot_level, position, origin_id
FROM character_resource WHERE id = ?;

insert:
INSERT INTO character_resource(party_member_id, name, max_value, current_value, slot_level, position, campaign_id, origin_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE character_resource SET name = ?, max_value = ?, current_value = ?, slot_level = ?, position = ? WHERE id = ?;

setCurrent:
UPDATE character_resource SET current_value = MIN(MAX(:value, 0), max_value) WHERE id = :id;

pressCell:
UPDATE character_resource SET current_value = CASE
    WHEN :index < current_value THEN current_value - 1
    ELSE MIN(current_value + 1, max_value)
END WHERE id = :id;

edit:
UPDATE character_resource SET name = :name, max_value = :max, current_value = MIN(current_value, :max) WHERE id = :id;

-- an undo puts the counts of a rest back as they were, even above the max the player lowered since
restoreCurrent:
UPDATE character_resource SET current_value = ? WHERE id = ?;

deleteById:
DELETE FROM character_resource WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
