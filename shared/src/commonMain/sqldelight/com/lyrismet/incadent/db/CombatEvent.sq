import com.lyrismet.incadent.feature.codex.domain.model.DamageType;
import com.lyrismet.incadent.feature.combat.domain.damage.HitScale;
import com.lyrismet.incadent.feature.combat.domain.model.CombatEventKind;
import com.lyrismet.incadent.feature.combat.domain.model.CombatState;
import com.lyrismet.incadent.feature.combat.domain.model.HitEffect;

CREATE TABLE combat_event (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    combat_id INTEGER NOT NULL REFERENCES combat(id) ON DELETE CASCADE,
    round INTEGER NOT NULL,
    kind TEXT AS CombatEventKind NOT NULL,
    source_id INTEGER REFERENCES combatant(id) ON DELETE SET NULL,
    target_id INTEGER NOT NULL REFERENCES combatant(id) ON DELETE CASCADE,
    amount INTEGER NOT NULL,
    damage_type TEXT AS DamageType,
    effect TEXT AS HitEffect NOT NULL,
    state TEXT AS CombatState,
    detail TEXT,
    turn INTEGER NOT NULL DEFAULT 0,
    hit INTEGER NOT NULL DEFAULT 0,
    raw INTEGER NOT NULL DEFAULT 0,
    scale TEXT AS HitScale NOT NULL
);

CREATE INDEX combat_event_combat_id ON combat_event(combat_id);

selectByCombat:
SELECT * FROM combat_event WHERE combat_id = ? ORDER BY id;

selectByCampaign:
SELECT combat_event.* FROM combat_event
JOIN combat ON combat.id = combat_event.combat_id
WHERE combat.campaign_id = ?
ORDER BY combat_event.id;

insert:
INSERT INTO combat_event(combat_id, round, kind, source_id, target_id, amount, damage_type, effect, state, detail, turn, hit, raw, scale)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateTerm:
UPDATE combat_event SET amount = ?, effect = ? WHERE id = ?;


lastInsertRowId:
SELECT last_insert_rowid();
