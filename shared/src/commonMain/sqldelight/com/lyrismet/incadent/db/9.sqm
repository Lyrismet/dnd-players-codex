-- foreign keys are on, so dropping location would null npc.location_id and quest.location_id, links are stashed first
CREATE TABLE npc_location_stash (
    npc_id INTEGER NOT NULL,
    location_id INTEGER NOT NULL
);

INSERT INTO npc_location_stash(npc_id, location_id)
SELECT id, location_id FROM npc WHERE location_id IS NOT NULL;

CREATE TABLE quest_location_stash (
    quest_id INTEGER NOT NULL,
    location_id INTEGER NOT NULL
);

INSERT INTO quest_location_stash(quest_id, location_id)
SELECT id, location_id FROM quest WHERE location_id IS NOT NULL;

CREATE TABLE location_new (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    parent_id INTEGER REFERENCES location_new(id) ON DELETE SET NULL
);

INSERT INTO location_new(id, name, description, parent_id)
SELECT id, name, description, NULL FROM location;

-- a region without a matching place becomes a top level place
INSERT INTO location_new(name, description, parent_id)
SELECT DISTINCT region, '', NULL FROM location
WHERE region <> '' AND region <> '—' AND region NOT IN (SELECT name FROM location_new);

UPDATE location_new
SET parent_id = (
    SELECT m.id FROM location_new m
    WHERE m.name = (SELECT o.region FROM location o WHERE o.id = location_new.id) AND m.id <> location_new.id
    ORDER BY m.id
    LIMIT 1
)
WHERE id IN (SELECT id FROM location WHERE region <> '' AND region <> '—');

DROP TABLE location;
ALTER TABLE location_new RENAME TO location;

CREATE INDEX location_parent_id ON location(parent_id);

UPDATE quest
SET location_id = (SELECT s.location_id FROM quest_location_stash s WHERE s.quest_id = quest.id)
WHERE id IN (SELECT quest_id FROM quest_location_stash);

DROP TABLE quest_location_stash;

CREATE TABLE npc_location (
    npc_id INTEGER NOT NULL REFERENCES npc(id) ON DELETE CASCADE,
    location_id INTEGER NOT NULL REFERENCES location(id) ON DELETE CASCADE,
    PRIMARY KEY (npc_id, location_id)
);

CREATE INDEX npc_location_location_id ON npc_location(location_id);

INSERT INTO npc_location(npc_id, location_id)
SELECT npc_id, location_id FROM npc_location_stash;

DROP TABLE npc_location_stash;

CREATE TABLE party_member_new (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    character_class TEXT NOT NULL DEFAULT '',
    race TEXT NOT NULL DEFAULT '',
    level INTEGER,
    player_name TEXT NOT NULL DEFAULT '',
    is_player_character INTEGER NOT NULL DEFAULT 0,
    presence TEXT NOT NULL DEFAULT 'IN',
    hp_max INTEGER,
    hp_current INTEGER,
    description TEXT NOT NULL DEFAULT '',
    portrait_uri TEXT
);

INSERT INTO party_member_new(
    id, name, character_class, race, level, player_name, is_player_character, presence, hp_max, hp_current,
    description, portrait_uri
)
SELECT
    id, name, character_class, race, level, player_name, is_player_character, presence, hp_max, hp_current,
    description, portrait_uri
FROM party_member;

DROP TABLE party_member;
ALTER TABLE party_member_new RENAME TO party_member;
