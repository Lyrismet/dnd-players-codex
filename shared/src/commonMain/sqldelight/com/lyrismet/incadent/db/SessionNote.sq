import kotlinx.datetime.LocalDateTime;

CREATE TABLE session_note (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    session_date TEXT AS LocalDateTime NOT NULL,
    ended_at TEXT AS LocalDateTime,
    created_at INTEGER NOT NULL
);

selectAll:
SELECT * FROM session_note ORDER BY session_date DESC;

selectById:
SELECT * FROM session_note WHERE id = ?;

insert:
INSERT INTO session_note(title, session_date, ended_at, created_at)
VALUES (?, ?, ?, ?);

update:
UPDATE session_note
SET title = ?, session_date = ?, ended_at = ?
WHERE id = ?;

deleteById:
DELETE FROM session_note WHERE id = ?;

endOtherLive:
UPDATE session_note
SET ended_at = ?
WHERE ended_at IS NULL AND id != ?;

lastInsertRowId:
SELECT last_insert_rowid();
