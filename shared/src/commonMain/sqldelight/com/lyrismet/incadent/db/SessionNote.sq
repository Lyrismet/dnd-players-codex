import kotlinx.datetime.LocalDateTime;

CREATE TABLE session_note (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    session_date TEXT AS LocalDateTime NOT NULL,
    ended_at TEXT AS LocalDateTime,
    created_at INTEGER NOT NULL,
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE
);

CREATE INDEX session_note_campaign_date ON session_note(campaign_id, session_date);

selectAll:
SELECT id, title, session_date, ended_at, created_at FROM session_note
WHERE campaign_id = ?
ORDER BY session_date DESC;

selectById:
SELECT id, title, session_date, ended_at, created_at FROM session_note WHERE id = ?;

insert:
INSERT INTO session_note(title, session_date, ended_at, created_at, campaign_id)
VALUES (?, ?, ?, ?, ?);

update:
UPDATE session_note
SET title = ?, session_date = ?, ended_at = ?
WHERE id = ?;

deleteById:
DELETE FROM session_note WHERE id = ?;

reopen:
UPDATE session_note SET ended_at = NULL WHERE id = ?;

endOtherLive:
UPDATE session_note
SET ended_at = ?
WHERE ended_at IS NULL AND id != ? AND campaign_id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
