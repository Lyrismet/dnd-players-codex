import kotlin.Boolean;
import com.lyrismet.incadent.feature.codex.domain.model.PartyPresence;
CREATE TABLE party_member (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    character_class TEXT NOT NULL DEFAULT '',
    race TEXT NOT NULL DEFAULT '',
    level INTEGER,
    player_name TEXT NOT NULL DEFAULT '',
    is_player_character INTEGER AS Boolean NOT NULL DEFAULT 0,
    presence TEXT AS PartyPresence NOT NULL DEFAULT 'IN',
    hp_max INTEGER,
    hp_current INTEGER,
    description TEXT NOT NULL DEFAULT '',
    portrait BLOB,
    portrait_thumb BLOB,
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE
);

CREATE INDEX party_member_campaign_id ON party_member(campaign_id);

-- list queries leave the full jpeg out, a row carries only its thumbnail
selectAll:
SELECT id, name, character_class, race, level, player_name, is_player_character, presence, hp_max, hp_current,
    description, portrait_thumb
FROM party_member
WHERE campaign_id = ?
ORDER BY name;

selectById:
SELECT id, name, character_class, race, level, player_name, is_player_character, presence, hp_max, hp_current,
    description, portrait_thumb, portrait
FROM party_member
WHERE id = ?;

insert:
INSERT INTO party_member(name, character_class, race, level, player_name, is_player_character, presence, hp_max, hp_current, description, portrait, portrait_thumb, campaign_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- puts a deleted record back under its old id, so the "@" tokens in notes find it again
insertWithId:
INSERT INTO party_member(id, name, character_class, race, level, player_name, is_player_character, presence, hp_max, hp_current, description, portrait, portrait_thumb, campaign_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- the photo is written on its own, so saving a list-level model never touches it
update:
UPDATE party_member
SET name = ?, character_class = ?, race = ?, level = ?, player_name = ?, is_player_character = ?, presence = ?,
    hp_max = ?, hp_current = ?, description = ?
WHERE id = ?;

setPortrait:
UPDATE party_member SET portrait = ?, portrait_thumb = ? WHERE id = ?;


clearOtherPlayerCharacters:
UPDATE party_member SET is_player_character = 0, player_name = '' WHERE is_player_character = 1 AND id != ? AND campaign_id = ?;

deleteById:
DELETE FROM party_member WHERE id = ?;

-- the stored jpeg sizes, what an export estimates its file from
selectPhotoSizes:
SELECT id, COALESCE(length(portrait), 0) AS size FROM party_member WHERE campaign_id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
