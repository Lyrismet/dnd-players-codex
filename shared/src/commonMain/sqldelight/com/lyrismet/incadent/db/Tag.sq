CREATE TABLE tag (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE,
    UNIQUE (campaign_id, name)
);

selectAll:
SELECT id, name FROM tag WHERE campaign_id = ? ORDER BY id ASC;

insert:
INSERT OR IGNORE INTO tag(name, campaign_id) VALUES (?, ?);

selectIdByName:
SELECT id FROM tag WHERE name = ? AND campaign_id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
